<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="serina.gui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="app-header">
            <padding>
                <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
            </padding>
            <Label styleClass="brand-label" text="Serina" />
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" styleClass="chat-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="14.0" left="12.0" right="12.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
            <BorderPane.margin>
                <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
            </BorderPane.margin>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0" styleClass="composer">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <TextField fx:id="userInput" maxWidth="1.7976931348623157E308"
                       onAction="#handleUserInput" promptText="Message Serina"
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" minWidth="84.0" onAction="#handleUserInput"
                    styleClass="send-button" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
